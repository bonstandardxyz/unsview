# Build artifacts
src/*.o
unsview
visualize
tests/make_sample
tests/strip_mesh
tests/check_corners

# Rendered output
*.png

# Real model meshes are NOT vendored — they are large and come from their
# projects' own download pages (see README "Getting sample data"). The
# exceptions are the samples/synthetic*.nc set: small self-contained meshes,
# generated by tests/make_sample.c, that the conda recipe renders on every
# platform to exercise all three readers.
samples/*.nc
!samples/synthetic.nc
!samples/synthetic_icon.nc
!samples/synthetic_ugrid.nc
!samples/synthetic_cs.nc
!samples/synthetic_cs_centers.nc
!samples/synthetic_fvcom.nc
samples/*.tar.gz
# Multi-model files pulled down by tests/fetch_testdata.sh.
samples/testdata/

# Local tooling / scratch
.omc/
.claude/settings.local.json
cmd

# A user's local defaults file is theirs, not the repo's.
.unsviewrc
